<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardBookmark"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:layout_margin="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/card_focus_selector"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/viewBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textBookmarkTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/textBookmarkUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="https://m.youtube.com"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:singleLine="true" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
